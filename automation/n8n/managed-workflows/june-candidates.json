    {
      "id": "03aae0fd5d7948cb",
      "name": "Validate bounded candidate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;\nconst fail=()=>[{json:{valid:false,ok:false,error:'INVALID_REQUEST',httpStatus:400}}];\nif(!b||typeof b!=='object'||Array.isArray(b)||Object.keys(b).some(k=>!['sessionId','messages'].includes(k)))return fail();\nif(typeof b.sessionId!=='string'||!/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(b.sessionId)||!Array.isArray(b.messages)||!b.messages.length||b.messages.length>100)return fail();\nlet size=0;for(const m of b.messages){if(!m||Object.keys(m).some(k=>!['role','content','timestamp'].includes(k))||!['user','assistant','system'].includes(m.role)||typeof m.content!=='string'||!m.content.trim()||m.content.length>16000||(size+=m.content.length)>48000||typeof m.timestamp!=='string'||!Number.isFinite(Date.parse(m.timestamp)))return fail();}\nreturn [{json:{valid:true,payload:{sessionId:b.sessionId,messages:b.messages}}}];"
      }
    },
